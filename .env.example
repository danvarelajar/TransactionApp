# --- Docker Compose (recommended) ---
# Copy this file to `.env` in the repo root. Compose reads `.env` for ${VAR} substitution in
# docker-compose.yml and passes it into containers via `env_file`.
#
# PAYMENT_DOMAIN / ATTACKER_DOMAIN must match your DNS (or WAF) hostnames.
# If PAYMENT_DOMAIN starts with payment., both apps derive attacker hostname as attacker.<same-rest>
# for script src / steal.js target ahead of ATTACKER_DOMAIN — keeps packetsoprano URLs if Host is stale.

# Domain Configuration
PAYMENT_DOMAIN=payment.example.demo
ATTACKER_DOMAIN=attacker.example.demo

# Optional: fixed attacker URL when Host is missing (fallback only unless forced).
# ATTACKER_URL=https://attacker.example.demo
#
# Prefer request Host + X-Forwarded-Proto for steal.js and checkout script src by default.
# To always use ATTACKER_URL even when browsers send a Host header:
# FORCE_ATTACKER_URL_FROM_ENV=1

# When payment and attacker share one public hostname (WAF routes /steal.js to attacker):
# USE_SAME_ORIGIN_ATTACKER=1

# WAF terminates TLS → set TRUST_PROXY=1 (default) so X-Forwarded-Proto/Host drive URLs.
# To disable Express trust-proxy: TRUST_PROXY=0

# If browsers must append a non-standard port to the attacker origin:
# ATTACKER_PUBLIC_PORT=8443

# Attacker server CORS: comma-separated origins, or hostname suffix allowlist
# ALLOWED_ORIGINS=https://payment.fortinet.demo,https://checkout.packetsoprano.com
TRUSTED_PAYMENT_ORIGIN_SUFFIX=fortinet.demo,packetsoprano.com

# Optional explicit CORS origins for the attacker container (otherwise suffix list above applies)
# ALLOWED_ORIGINS=https://payment.packetsoprano.com,https://attacker.packetsoprano.com

# External Port Configuration
# These are the ports you access from your browser/host machine
# Change these if ports 80 or 8080 are already in use
# If you map them in docker-compose (e.g. "${PAYMENT_PORT:-3000}:3000"), never leave
# these empty — empty values cause Compose to emit "invalid proto" when parsing ports.
PAYMENT_PORT=3000
ATTACKER_PORT=3001

# Internal Port Configuration (Advanced - usually don't need to change)
# These are the ports the applications listen on INSIDE the containers
# Only change if you modify the application code to listen on different ports
# Must match the PORT environment variable passed to the apps
PAYMENT_INTERNAL_PORT=3000
ATTACKER_INTERNAL_PORT=3001
