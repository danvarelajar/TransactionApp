# Optional: copy to docker-compose.override.yml — Compose merges this with docker-compose.yml
# automatically. Keep only differences here (typically host port remaps); the full stack
# lives in docker-compose.yml alone.
#
# WAF/off-box TLS: apps still honor X-Forwarded-Proto when the edge forwards it.

services:
  app:
    ports:
      - "8080:3000"

  attacker:
    ports:
      - "8081:3001"
