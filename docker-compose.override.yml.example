# Copy to docker-compose.override.yml for local-only changes (merged with docker-compose.yml).

services:
  app:
    env_file: .env
    build: ./app
    hostname: ${PAYMENT_DOMAIN:-payment.example.com}
    ports:
      - "${PAYMENT_PORT:-3000}:${PAYMENT_INTERNAL_PORT:-3000}"
    environment:
      - PORT=${PAYMENT_INTERNAL_PORT:-3000}
    extra_hosts:
      - "${PAYMENT_DOMAIN:-payment.example.com}:127.0.0.1"
      - "${ATTACKER_DOMAIN:-attacker.example.com}:127.0.0.1"

  attacker:
    env_file: .env
    build: ./attacker
    hostname: ${ATTACKER_DOMAIN:-attacker.example.com}
    ports:
      - "${ATTACKER_PORT:-3001}:${ATTACKER_INTERNAL_PORT:-3001}"
    environment:
      - PORT=${ATTACKER_INTERNAL_PORT:-3001}
    extra_hosts:
      - "${PAYMENT_DOMAIN:-payment.example.com}:127.0.0.1"
      - "${ATTACKER_DOMAIN:-attacker.example.com}:127.0.0.1"
